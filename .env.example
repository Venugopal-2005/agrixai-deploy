SECRET_KEY=replace_with_strong_random_secret

# Firebase Admin SDK (backend token verification)
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\serviceAccountKey.json

# Firebase Web SDK (frontend email/password + phone OTP)
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=1234567890
FIREBASE_WEB_APP_ID=1:1234567890:web:abcdef123456
